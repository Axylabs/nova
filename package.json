{
  "name": "@ignex/nova",
  "version": "0.1.7",
  "type": "module",
  "description": "TypeBox-driven FlatBuffer transport: Rust FFI serializer + Bun WebSocket + typed pub/sub API for server and FE.",
  "license": "MIT",
  "author": "ignex-nova contributors",
  "keywords": [
    "flatbuffers",
    "websocket",
    "pubsub",
    "realtime",
    "typebox",
    "bun",
    "ffi",
    "rust",
    "nats",
    "typed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignex-nova/ignex-nova.git"
  },
  "homepage": "https://github.com/ignex-nova/ignex-nova#readme",
  "bugs": {
    "url": "https://github.com/ignex-nova/ignex-nova/issues"
  },
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4"
  },
  "files": [
    "index.ts",
    "public",
    "src",
    "rust",
    "rust-toolchain.toml",
    "prebuilds",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "browser": "./public/client.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./public/server.ts",
    "./client": "./public/client.ts",
    "./nats": "./public/nats.ts",
    "./events": "./public/events.ts",
    "./bindings": "./public/bindings.ts",
    "./generate": "./public/generate.ts",
    "./internal": "./public/internal.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "nova": {
    "flatc": "25.9.23",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml",
    "build:client": "bun build ./client/main.ts --outdir ./client-dist --target=browser --splitting",
    "build:dist": "bun build ./index.ts ./public/server.ts ./public/client.ts ./public/nats.ts ./public/events.ts ./public/bindings.ts ./public/generate.ts ./public/internal.ts --outdir ./dist --target=bun --splitting && bunx tsc --emitDeclarationOnly -p tsconfig.dist.json",
    "build": "bun run generate && bun run build:rust && bun run build:client",
    "prebuild": "bun scripts/build-prebuild.ts",
    "postinstall": "bun scripts/postinstall.ts",
    "pretest": "bun run build:client",
    "test": "bun test",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "rust:fmt": "rustfmt --edition 2021 --check --config skip_children=true rust/src/lib.rs rust/src/ffi.rs rust/examples/dump.rs",
    "rust:fmt:write": "rustfmt --edition 2021 --config skip_children=true rust/src/lib.rs rust/src/ffi.rs rust/examples/dump.rs",
    "rust:clippy": "cargo clippy --manifest-path rust/Cargo.toml --all-targets -- -D warnings",
    "lint": "bunx oxlint",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "check:version": "bun scripts/check-version.ts",
    "verify": "bun run typecheck && bun run lint && bun run check:version && bun run test",
    "pack:check": "bun scripts/check-pack.ts",
    "prepublish:verify": "bun scripts/prepublish.ts",
    "verify:install": "bun scripts/verify-install.ts",
    "gen:ai-map": "bun scripts/gen-ai-map.ts",
    "serve": "bun run src/server.ts",
    "bench:serialize": "bun run bench/serialize.ts",
    "bench:dispatch": "bun run bench/dispatch.ts",
    "bench:throughput": "bun run bench/throughput.ts",
    "release": "bun scripts/release.ts",
    "release:dry": "bun scripts/release.ts --dry-run",
    "release:manual": "bun scripts/release.ts --publish",
    "prepublishOnly": "bun run generate && bun run verify && bun run prepublish:verify",
    "prepack": "bun run prebuild"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "flatbuffers": "^25.9.23",
    "nats": "^2.29.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.10",
    "oxlint": "^1.78.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  }
}
